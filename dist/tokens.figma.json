{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$comment": "LIULIAN canonical design tokens. Source: feat/gui-demo iteration 2 (styles/main.css). Edit here; build script generates per-platform exports.",
  "color": {
    "canvas": {
      "warm": {
        "$type": "color",
        "$description": "Warm paper, primary background. Never use #fff.",
        "$value": "#FBFBFA"
      },
      "soft": {
        "$type": "color",
        "$value": "#F7F6F3"
      },
      "warmer": {
        "$type": "color",
        "$value": "#F2F0EA"
      }
    },
    "surface": {
      "pure": {
        "$type": "color",
        "$description": "Card surface; functional only.",
        "$value": "#FFFFFF"
      },
      "shade": {
        "$type": "color",
        "$value": "#FAFAF9"
      }
    },
    "ink": {
      "charcoal": {
        "$type": "color",
        "$description": "Body text. Never use #000.",
        "$value": "#131313"
      },
      "strong": {
        "$type": "color",
        "$value": "#1F1F1F"
      },
      "soft": {
        "$type": "color",
        "$value": "#34373B"
      },
      "muted": {
        "$type": "color",
        "$value": "#666A70"
      },
      "faint": {
        "$type": "color",
        "$value": "#94989D"
      },
      "quiet": {
        "$type": "color",
        "$value": "#C0C2C5"
      }
    },
    "unibe-red": {
      "DEFAULT": {
        "$type": "color",
        "$description": "Brand anchor. Spot color only. Max 2 visible per viewport on most pages.",
        "$value": "#E20613"
      },
      "deep": {
        "$type": "color",
        "$description": "Hover/focus/destructive-confirm.",
        "$value": "#B00010"
      },
      "tint": {
        "$type": "color",
        "$description": "Pill backgrounds, CI band fills.",
        "$value": "#FDEBEC"
      },
      "tint-2": {
        "$type": "color",
        "$value": "#FAD9DC"
      },
      "text": {
        "$type": "color",
        "$value": "#9F2F2D"
      }
    },
    "status": {
      "green": {
        "$type": "color",
        "$value": "#2E7D43"
      },
      "green-pale": {
        "$type": "color",
        "$value": "#E5F0E7"
      },
      "blue": {
        "$type": "color",
        "$value": "#1F6C9F"
      },
      "blue-pale": {
        "$type": "color",
        "$value": "#E1F1FB"
      },
      "amber": {
        "$type": "color",
        "$value": "#946400"
      },
      "amber-pale": {
        "$type": "color",
        "$value": "#FBF1D9"
      }
    },
    "hairline": {
      "DEFAULT": {
        "$type": "color",
        "$value": "#E8E7E2"
      },
      "strong": {
        "$type": "color",
        "$value": "#DEDCD4"
      },
      "stronger": {
        "$type": "color",
        "$value": "#C9C7BF"
      }
    },
    "unibe-secondary": {
      "$comment": "UniBe corporate secondary (from unibeCols R package). CHART SERIES ONLY — never UI fill.",
      "ocean": {
        "$type": "color",
        "$value": "#0066B3"
      },
      "green": {
        "$type": "color",
        "$value": "#509A39"
      },
      "apricot": {
        "$type": "color",
        "$value": "#E6863A"
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Fraunces",
        "Instrument Serif",
        "Times New Roman",
        "serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Switzer",
        "SF Pro Text",
        "Helvetica Neue",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono",
        "SF Mono",
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "fontSize": {
    "xs": {
      "$value": "10.5px"
    },
    "sm": {
      "$value": "12px"
    },
    "md": {
      "$value": "13.5px"
    },
    "lg": {
      "$value": "15px"
    },
    "xl": {
      "$value": "18px"
    },
    "2xl": {
      "$value": "22px"
    },
    "3xl": {
      "$value": "28px"
    },
    "4xl": {
      "$value": "38px"
    },
    "5xl": {
      "$value": "56px"
    },
    "6xl": {
      "$value": "96px"
    },
    "display": {
      "$value": "144px"
    }
  },
  "spacing": {
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "20px"
    },
    "6": {
      "$value": "24px"
    },
    "7": {
      "$value": "32px"
    },
    "8": {
      "$value": "48px"
    },
    "9": {
      "$value": "64px"
    },
    "10": {
      "$value": "96px"
    },
    "11": {
      "$value": "128px"
    }
  },
  "radius": {
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$description": "Card default",
      "$value": "10px"
    },
    "lg": {
      "$value": "14px"
    },
    "xl": {
      "$value": "20px"
    },
    "pill": {
      "$value": "9999px"
    }
  },
  "border": {
    "hairline": {
      "$value": "1px solid #E8E7E2"
    }
  },
  "motion": {
    "ease-out": {
      "$value": "cubic-bezier(0.22, 1, 0.36, 1)"
    },
    "ease-out-quart": {
      "$value": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "ease-in-out": {
      "$value": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "duration-instant": {
      "$value": "80ms"
    },
    "duration-fast": {
      "$value": "180ms"
    },
    "duration-medium": {
      "$value": "300ms"
    },
    "duration-slow": {
      "$value": "600ms"
    }
  },
  "control": {
    "$comment": "Component-level sizing. Used by Button, Input, Tab, ListItem in ui-spec.",
    "height": {
      "sm": {
        "$type": "dimension",
        "$value": "32px"
      },
      "md": {
        "$type": "dimension",
        "$description": "Button/Input standard. Touch target padded to 44px on iOS, 48dp on Android via outer area.",
        "$value": "40px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "48px"
      }
    },
    "paddingX": {
      "sm": {
        "$type": "dimension",
        "$value": "16px"
      },
      "md": {
        "$type": "dimension",
        "$value": "24px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "28px"
      }
    },
    "iconSize": {
      "sm": {
        "$type": "dimension",
        "$value": "14px"
      },
      "md": {
        "$type": "dimension",
        "$value": "16px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "18px"
      }
    },
    "iconGap": {
      "DEFAULT": {
        "$type": "dimension",
        "$value": "8px"
      }
    },
    "scaleActive": {
      "DEFAULT": {
        "$type": "number",
        "$description": "Press-state scale (uniform; not just iOS, not just Android — LIULIAN's own).",
        "$value": "0.98"
      }
    }
  },
  "focus": {
    "$comment": "Focus ring is a brand element — visible by default, not just keyboard-on-tab.",
    "ringWidth": {
      "$type": "dimension",
      "$value": "2px"
    },
    "ringOffset": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "shadow": {
    "$comment": "Editorial-Swiss = sparse shadow use. Most components use border + canvas elevation, not shadow.",
    "rest": {
      "$type": "shadow",
      "$value": "none"
    },
    "raise": {
      "$type": "shadow",
      "$description": "Card hover",
      "$value": "0 2px 8px rgba(19,19,19,0.04)"
    },
    "lift": {
      "$type": "shadow",
      "$description": "Modal / floating panel",
      "$value": "0 8px 24px rgba(19,19,19,0.06)"
    }
  },
  "opacity": {
    "disabled": {
      "$type": "number",
      "$value": "0.4"
    },
    "subtle": {
      "$type": "number",
      "$value": "0.65"
    }
  },
  "touch": {
    "$comment": "Minimum tap target sizes per platform. Wrap visually-smaller controls in an invisible padding region.",
    "minTarget-ios": {
      "$type": "dimension",
      "$description": "Apple HIG",
      "$value": "44px"
    },
    "minTarget-android": {
      "$type": "dimension",
      "$description": "Material Design",
      "$value": "48px"
    },
    "minTarget-harmony": {
      "$type": "dimension",
      "$description": "HMS Design (Huawei)",
      "$value": "48px"
    }
  }
}
